# ReelSong Backend Configuration

PORT=5050
NODE_ENV=development

# Music Recognition Provider: "audd" or "acrcloud"
MUSIC_PROVIDER=audd

# AudD Configuration (https://audd.io/)
AUDD_API_TOKEN=

# ACRCloud Configuration (https://www.acrcloud.com/)
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=15

